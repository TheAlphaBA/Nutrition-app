# Backend Environment Variables
# Copy this file to .env and fill in the values

# AI Provider: "gemini" or "openai"
LLM_PROVIDER=gemini

# Google Gemini API Key (get free at https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI API Key (optional fallback if using OpenAI)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Database URL (default: SQLite in project directory)
DATABASE_URL=sqlite:///./nutrition.db

# Environment (development | production)
ENVIRONMENT=development

# CORS allowed origins (comma-separated for multiple)
CORS_ORIGINS=http://localhost:3000

# Logging level (debug | info | warning | error)
LOG_LEVEL=info
